# HTLB Candidate Tracker: copy this file to .env.local and fill in the values
# from Supabase → Project Settings → API. In Vercel, add the same three under
# Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret. Only used on the server, for Settings → Team users (add people, reset passwords).
# Never share it or put it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
